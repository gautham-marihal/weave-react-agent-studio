# Copy to .env.docker (git-ignored) and fill in. Read by the studio container when it starts (docker-compose.yml);
# nothing here is built into the image or sent to the browser.

# The Agent Builder API and its key
AGENT_BUILDER_URL=http://16.79.174.151:8100
AGENT_BUILDER_API_KEY=
# The name the API records for saves, publishes and deploys (in production, the sign-in in front sets it)
AGENT_BUILDER_USER=

# The APIs Integrations › Test connection may call through the studio (GET only), comma separated:
# the bank database and the mock bank services
API_PASS_TARGETS=http://16.79.174.151:3322,https://weave-mock-api.vercel.app

# Optional: the Describe assistant's AI model (without it, only the built-in draft rules)
ANTHROPIC_API_KEY=
# LLM_MODELS=
# LLM_BASE_URL=

# On a server, with HTTPS and a password in front (docker compose --profile https): the domain (pointing at the
# server), who signs in, and the password's hash (docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '…').
# The hash starts with $2a$: write every $ as $$ here, so Docker Compose keeps it as it is.
STUDIO_DOMAIN=studio.example.com
STUDIO_USER=admin
STUDIO_PASSWORD_HASH=


# Optional: which Windows Server the Windows-container images are for (./run.sh export-windows): ltsc2022 or ltsc2025
# WINDOWS_VERSION=ltsc2022
