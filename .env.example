# Copy to .env.local (git-ignored). Read by the Vite dev/preview server only.
# No VITE_ prefix on purpose: these are never bundled into the browser code.
AGENT_BUILDER_URL=http://localhost:8100
AGENT_BUILDER_API_KEY=
# Who the API records as the user for saves, publishes and deploys while developing. Server side only.
# (In production the proxy sets this from the verified sign-in, see docs/PRODUCTION.md.)
AGENT_BUILDER_USER=

# The Describe assistant ("tell it what you need in plain English"). Without a key the studio offers only the simple built-in draft rules,
# which are not an AI model. With one, your description and the current draft are sent to the provider; see README.
ANTHROPIC_API_KEY=
# Optional: which models may be chosen (comma separated, first is the default), and another Anthropic-compatible address.
LLM_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5
LLM_BASE_URL=https://api.anthropic.com
