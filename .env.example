# Where the Agent Builder API runs. Required for `npm run dev` and `npm run preview` (the /api proxy target).
AGENT_BUILDER_URL=http://localhost:8100
# Bearer key the proxy adds to every request. Stays on the server; never sent to the browser.
AGENT_BUILDER_API_KEY=
# Fallback X-User when the browser sends none (requests made before sign-in).
AGENT_BUILDER_USER=

# Banking gateway (services/banking-gateway). Optional; without it banking runs on the mock bank in the browser.
# Where it runs, e.g. the mock: `npm --prefix services/banking-gateway run start:mock` prints its address and token.
# Studio also fills this address into banking agents (their banking_gateway_url), so nobody types it.
BANKING_GATEWAY_URL=
# Optional: the address the agent runtime uses when it differs from the one above (e.g. a public one instead of
# localhost). Filled into banking agents instead of BANKING_GATEWAY_URL.
BANKING_GATEWAY_RUNTIME_URL=
# The gateway's runtime token (GATEWAY_TOKEN). Added by the proxy to read-only routes only; never sent to the browser.
BANKING_GATEWAY_TOKEN=
# "on" lets Studio start its own test sessions (rehearsals) on the gateway server (its /dev/ routes) and run tools
# for them only: on the mock bank, or on CIMB's systems when the gateway runs there (npm run dev sets it).
BANKING_GATEWAY_REHEARSALS=

# CIMB, the bank's real systems for Live mode. With CIMB_BASE_URL set, `npm run dev` starts the gateway on CIMB's
# TetherfiDbRestApi (services/banking-gateway/src/main.ts) instead of the mock bank; Sandbox keeps the mock bank.
# Customers sign in with their CIMB customer id as the 7-digit Phone Code and their 6-digit passcode as the PIN.
CIMB_BASE_URL=
# The Region header every CIMB request carries (default DB2).
CIMB_REGION=

# "Describe it" (an AI model proposes changes to an agent). Optional; without a key Studio says no AI model is set up.
# The key stays on this server (the /llm route adds it); it is never sent to the browser.
ANTHROPIC_API_KEY=
# Which Claude models may be chosen, comma-separated (default: claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5).
LLM_MODELS=
# The model used unless another allowed one is chosen (default: the first of LLM_MODELS).
LLM_MODEL=

# Sandbox only: a studio that runs on sample data kept in the browser and cannot switch to Live (true / unset).
# Without it, the top bar's Live | Sandbox switch chooses, and Live is the default.
VITE_SANDBOX=
