{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "types": ["vite/client"],
    "skipLibCheck": true
  },
  "include": ["src", "scripts", "e2e", "tests"]
}
