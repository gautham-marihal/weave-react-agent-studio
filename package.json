    "e2e:legibility": "node e2e/legibility.mjs",
    "e2e:tryline": "node e2e/tryline.mjs",
    "e2e:numbers": "node e2e/numbers.mjs",
    "e2e:voices": "node e2e/voices.mjs",
    "e2e:channels": "node e2e/channels.mjs",
    "e2e:insights": "node e2e/insights.mjs",
    "e2e:live": "node e2e/live.mjs",
    "e2e:speed": "node e2e/speed.mjs",
    "e2e:setup": "node e2e/setup.mjs",
    "e2e:guardrails": "node e2e/guardrails.mjs",
